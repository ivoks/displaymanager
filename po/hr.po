#: ddm/cli.py:46
msgid ""
"Control a monitor's inputs, screen layout and KVM over DDC/CI. Run without "
"arguments for the graphical application."
msgstr ""
"Upravljanje ulazima, rasporedom zaslona i KVM-om monitora putem DDC/CI. "
"Pokrenite bez argumenata za grafičku aplikaciju."

#: ddm/cli.py:50
msgid "don't show a desktop notification"
msgstr "ne prikazuj obavijest na radnoj površini"

#: ddm/cli.py:52
msgid "show the monitor's state"
msgstr "prikaži stanje monitora"

#: ddm/cli.py:53
msgid ""
"with two inputs on screen move the keyboard and mouse, otherwise switch the "
"full-screen input"
msgstr ""
"s dva ulaza na zaslonu premjesti tipkovnicu i miš, inače promijeni ulaz "
"prikazan preko cijelog zaslona"

#: ddm/cli.py:56
msgid "keyboard and mouse: here, away or toggle"
msgstr ""
"tipkovnica i miš: here (ovamo), away (na drugo računalo) ili toggle (prebaci)"

#: ddm/cli.py:60
msgid "swap the two inputs"
msgstr "zamijeni dva ulaza"

#: ddm/cli.py:61
msgid "side by side: on (last used layout), off or toggle"
msgstr "jedan pored drugog: on (zadnji korišteni raspored), off ili toggle"

#: ddm/cli.py:65
msgid ""
"screen layout: list, next, or a name (single, 50-50, 75-25, 80-20, 25-75, "
"20-80, pip-small, pip-large)"
msgstr ""
"raspored zaslona: list, next ili naziv (single, 50-50, 75-25, 80-20, 25-75, "
"20-80, pip-small, pip-large)"

#: ddm/cli.py:68
msgid "select the main input by hex code, e.g. 0x0f"
msgstr "odaberi glavni ulaz heksadecimalnim kodom, npr. 0x0f"

#: ddm/cli.py:71
msgid "select the second input (right side or inset) by hex code, e.g. 0x19"
msgstr ""
"odaberi drugi ulaz (desna strana ili umetak) heksadecimalnim kodom, npr. 0x19"

#: ddm/cli.py:75
msgid "show or set brightness: 0–100, +N or -N"
msgstr "prikaži ili postavi svjetlinu: 0–100, +N ili -N"

#: ddm/cli.py:76
msgid "show or set contrast: 0–100, +N or -N"
msgstr "prikaži ili postavi kontrast: 0–100, +N ili -N"

#: ddm/cli.py:77
msgid "show or set the speaker volume: 0–100, +N or -N"
msgstr "prikaži ili postavi glasnoću zvučnika: 0–100, +N ili -N"

#: ddm/cli.py:81
msgid "list the inputs the monitor reports"
msgstr "prikaži ulaze koje monitor prijavljuje"

#: ddm/cli.py:82
msgid ""
"the pointer reached this screen edge: move the keyboard and mouse if the "
"other computer is on that side (used by the GNOME extension)"
msgstr ""
"pokazivač je došao do ovog ruba zaslona: premjesti tipkovnicu i miš ako je "
"drugo računalo s te strane (koristi GNOME proširenje)"

#: ddm/cli.py:87
msgid "work out which input this computer is plugged into"
msgstr "utvrdi na koji je ulaz priključeno ovo računalo"

